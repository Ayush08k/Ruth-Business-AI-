# ============================================
# RUTH AI ASSISTANT - Configuration
# Copy this file to .env and fill in values
# ============================================

# --- LLM (Google Gemini - Free Tier Available) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Gmail (for email reading + sending reports) ---
# Download credentials.json from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=ruth_data/token.json
REPORT_EMAIL=your_email@gmail.com

# --- Website Monitoring ---
WEBSITE_URL=https://your-website.com
WEBSITE_CHECK_INTERVAL=300

# --- Voice Settings ---
VOICE_LANGUAGE_DEFAULT=en
WAKE_WORD=hey ruth
VOICE_EN=en-US-JennyNeural
VOICE_HI=hi-IN-SwaraNeural

# --- Picovoice (Wake Word - Free Tier) ---
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# --- Paths ---
RUTH_DATA_DIR=ruth_data
MEMORY_DIR=ruth_data/memory
DB_PATH=ruth_data/ruth.db
LOG_DIR=logs

# --- Report Schedule (24h format) ---
MORNING_BRIEFING_TIME=07:00
EMAIL_CHECK_INTERVAL_HOURS=2

